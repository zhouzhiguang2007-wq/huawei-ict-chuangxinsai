{
  "$schema": "./plugin.schema.json",
  "name": "travel-planner-plugin",
  "version": "0.2.0",
  "display_name": "旅行规划插件",
  "description": "端到端旅游规划工作流：需求确认→资料核实→住宿→拍照→合成报告→复核→手册，含自建本地 RAG",
  "install_check": "scripts/check_install.py",
  "entry_skill": "travel-planner-plugin",
  "skills": [
    "travel-planner-plugin",
    "travel-requirement-analysis",
    "multi-platform-travel-planner",
    "travel-accommodation-advisor",
    "x-xiake",
    "travel-plan-review",
    "travel-handbook-builder",
    "travel-replanner",
    "travel-time-pocket"
  ],
  "orchestration": {
    "main_flow": [
      "travel-requirement-analysis",
      "multi-platform-travel-planner",
      "travel-accommodation-advisor",
      "x-xiake",
      "multi-platform-travel-planner",
      "travel-plan-review",
      "travel-handbook-builder"
    ],
    "post_delivery": ["travel-replanner", "travel-time-pocket"]
  },
  "rag": {
    "type": "local_vector",
    "index_dir": "rag/index",
    "build_script": "rag/build_index.py",
    "validate_script": "rag/scripts/validate_skill_manifest.py",
    "retrieve_script": "rag/retrieve.py",
    "embedding_model": "paraphrase-multilingual-MiniLM-L12-v2",
    "top_k": 5
  },
  "agent": "travel-planner",
  "shared_tools": {
    "contract_version": "1.1",
    "module": "travel_shared",
    "contract_document": "docs/shared-interface.md",
    "openapi": "contracts/tools.openapi.json",
    "storage": "sqlite",
    "database_env": "TRAVEL_PREFERENCES_DB",
    "internal_database_env": "TRAVEL_INTERNAL_DB",
    "runtime_root_env": "TRAVEL_SHARED_ROOT",
    "requires_seed": true,
    "actions": [
      "get",
      "update",
      "delete",
      "clear",
      "invoke",
      "seed",
      "knowledge_query",
      "knowledge_upsert",
      "knowledge_categories",
      "session_put",
      "session_get",
      "session_get_requirements",
      "session_list_trips",
      "session_clear_stage",
      "session_clear_trip",
      "registry_query",
      "registry_list",
      "registry_get",
      "registry_dependencies",
      "questionnaire_list",
      "questionnaire_get_step",
      "questionnaire_next",
      "questionnaire_dimensions",
      "prepare"
    ],
    "questionnaire": {
      "steps": 12,
      "storage": "sqlite:guided_questions",
      "requires_seed": true,
      "gate": "before_planning",
      "action_read": "questionnaire_get_step"
    },
    "requirement_agent": "agents/travel-requirement-analysis.md",
    "auto_registered": false
  },
  "source": "GPT/team-travel-skills-2026-10-25",
  "mcp_servers": {
    "railway": {
      "name": "12306-mcp",
      "type": "community",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "12306-mcp"],
      "tools": [
        "get-current-date",
        "get-stations-code-in-city",
        "get-station-code-of-citys",
        "get-station-code-by-names",
        "get-station-by-telecode",
        "get-tickets"
      ],
      "document": "docs/12306-mcp-setup.md",
      "note": "Community implementation reading official 12306 data; cite tool name and query time, defer to official page before payment. Host-side configuration, not auto-installed by the repo."
    },
    "map": {
      "name": "amap",
      "type": "host-provided",
      "note": "Optional. Used for POI matching and first/last-mile routes; cannot verify railway trains, fares or seats."
    }
  },
  "codearts_compat": {
    "skill_frontmatter_fields": ["name", "description", "language", "allowed-tools"],
    "agent_definition_format": "markdown",
    "no_builtin_rag": true
  }
}
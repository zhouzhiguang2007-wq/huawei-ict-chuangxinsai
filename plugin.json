{
  "$schema": "./plugin.schema.json",
  "name": "travel-planner-plugin",
  "version": "0.3.0",
  "display_name": "旅行规划插件",
  "description": "端到端旅游规划工作流：需求确认→资料核实→住宿→拍照→合成报告→复核→手册，含自建本地 RAG",
  "install_check": "scripts/check_install.py",
  "entry_skill": "travel-planner-plugin",
  "skills": [
    "travel-planner-plugin",
    "travel-requirement-analysis",
    "multi-platform-travel-planner",
    "travel-accommodation-advisor",
    "x-xiake",
    "travel-plan-review",
    "travel-handbook-builder",
    "travel-replanner",
    "travel-time-pocket"
  ],
  "orchestration": {
    "main_flow": [
      "travel-requirement-analysis",
      "multi-platform-travel-planner",
      "travel-accommodation-advisor",
      "x-xiake",
      "multi-platform-travel-planner",
      "travel-plan-review",
      "travel-handbook-builder"
    ],
    "post_delivery": [
      "travel-replanner",
      "travel-time-pocket"
    ]
  },
  "rag": {
    "type": "local_vector",
    "index_dir": "rag/index",
    "build_script": "rag/build_index.py",
    "validate_script": "rag/scripts/validate_skill_manifest.py",
    "retrieve_script": "rag/retrieve.py",
    "embedding_model": "paraphrase-multilingual-MiniLM-L12-v2",
    "requirements": "requirements-rag.txt",
    "top_k": 5
  },
  "agent": "travel-planner",
  "shared_tools": {
    "contract_version": "1.1",
    "module": "travel_shared",
    "contract_document": "docs/shared-interface.md",
    "openapi": "contracts/tools.openapi.json",
    "storage": "sqlite",
    "database_env": "TRAVEL_PREFERENCES_DB",
    "internal_database_env": "TRAVEL_INTERNAL_DB",
    "runtime_root_env": "TRAVEL_SHARED_ROOT",
    "requires_seed": true,
    "actions": [
      "get",
      "update",
      "delete",
      "clear",
      "invoke",
      "seed",
      "knowledge_query",
      "knowledge_upsert",
      "knowledge_categories",
      "session_put",
      "session_get",
      "session_get_requirements",
      "session_list_trips",
      "session_clear_stage",
      "session_clear_trip",
      "registry_query",
      "registry_list",
      "registry_get",
      "registry_dependencies",
      "questionnaire_list",
      "questionnaire_get_step",
      "questionnaire_next",
      "questionnaire_dimensions",
      "prepare"
    ],
    "questionnaire": {
      "steps": 13,
      "storage": "sqlite:guided_questions",
      "requires_seed": true,
      "gate": "before_planning",
      "action_read": "questionnaire_get_step"
    },
    "requirement_agent": "agents/travel-requirement-analysis.md",
    "auto_registered": false
  },
  "skill_graph": {
    "document": "docs/skill-map.md",
    "nodes": [
      "travel-planner-plugin",
      "travel-requirement-analysis",
      "multi-platform-travel-planner",
      "travel-accommodation-advisor",
      "x-xiake",
      "travel-plan-review",
      "travel-handbook-builder",
      "travel-replanner",
      "travel-time-pocket"
    ],
    "edges": [
      {
        "from": "travel-planner-plugin",
        "to": "travel-requirement-analysis",
        "kind": "delegates"
      },
      {
        "from": "travel-planner-plugin",
        "to": "multi-platform-travel-planner",
        "kind": "delegates"
      },
      {
        "from": "travel-planner-plugin",
        "to": "travel-accommodation-advisor",
        "kind": "delegates"
      },
      {
        "from": "travel-planner-plugin",
        "to": "x-xiake",
        "kind": "delegates"
      },
      {
        "from": "travel-planner-plugin",
        "to": "travel-plan-review",
        "kind": "delegates"
      },
      {
        "from": "travel-planner-plugin",
        "to": "travel-handbook-builder",
        "kind": "delegates"
      },
      {
        "from": "travel-requirement-analysis",
        "to": "multi-platform-travel-planner",
        "kind": "requirements"
      },
      {
        "from": "travel-requirement-analysis",
        "to": "travel-accommodation-advisor",
        "kind": "requirements"
      },
      {
        "from": "multi-platform-travel-planner",
        "to": "travel-accommodation-advisor",
        "kind": "spots_and_dates"
      },
      {
        "from": "multi-platform-travel-planner",
        "to": "x-xiake",
        "kind": "spots"
      },
      {
        "from": "x-xiake",
        "to": "multi-platform-travel-planner",
        "kind": "photo_guides"
      },
      {
        "from": "multi-platform-travel-planner",
        "to": "travel-plan-review",
        "kind": "itinerary"
      },
      {
        "from": "travel-plan-review",
        "to": "travel-handbook-builder",
        "kind": "reviewed_itinerary"
      },
      {
        "from": "travel-plan-review",
        "to": "travel-replanner",
        "kind": "blocking_issue"
      },
      {
        "from": "travel-replanner",
        "to": "travel-plan-review",
        "kind": "replanned_itinerary"
      },
      {
        "from": "travel-plan-review",
        "to": "travel-time-pocket",
        "kind": "free_window"
      },
      {
        "from": "travel-planner-plugin",
        "to": "travel-replanner",
        "kind": "delegates"
      },
      {
        "from": "travel-planner-plugin",
        "to": "travel-time-pocket",
        "kind": "delegates"
      }
    ],
    "shared_state": {
      "module": "travel_shared",
      "session_key": "session_context",
      "knowledge_key": "travel_knowledge",
      "registry_key": "skill_registry",
      "questionnaire_key": "guided_questions"
    }
  },
  "deployment": {
    "target": "huawei-cloud-agentarts",
    "entry_agent": "agents/travel-planner.md",
    "skills_dir": "skills",
    "guide": "docs/deploy-agentarts.md",
    "requires": {
      "python": "3.9+",
      "node": "18+ (optional, for 12306-mcp)",
      "persistent_disk": true,
      "env": [
        "TRAVEL_INTERNAL_DB",
        "TRAVEL_SHARED_ROOT",
        "TRAVEL_TOOL_TOKENS"
      ]
    },
    "backend": {
      "type": "http",
      "module": "travel_shared.server",
      "endpoint": "POST /v1/tools",
      "openapi": "contracts/tools.openapi.json"
    },
    "mcp": [
      "railway",
      "map",
      "weather"
    ],
    "rag": "optional"
  },
  "acceptance": {
    "script": "scripts/e2e_smoke.py",
    "e2e": "docs/acceptance-e2e.md",
    "mcp": "docs/acceptance-mcp.md",
    "manual": "docs/acceptance-manual.md",
    "demo": "docs/demo-script.md",
    "weather": "docs/weather-setup.md",
    "accommodation": "docs/accommodation-tools.md"
  },
  "source": "GPT/team-travel-skills-2026-10-25",
  "mcp_servers": {
    "railway": {
      "name": "12306-mcp",
      "type": "community",
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "12306-mcp"
      ],
      "tools": [
        "get-current-date",
        "get-stations-code-in-city",
        "get-station-code-of-citys",
        "get-station-code-by-names",
        "get-station-by-telecode",
        "get-tickets"
      ],
      "document": "docs/12306-mcp-setup.md",
      "note": "Community implementation reading official 12306 data; cite tool name and query time, defer to official page before payment. Host-side configuration, not auto-installed by the repo."
    },
    "map": {
      "name": "amap",
      "type": "host-provided",
      "note": "Optional. Host-provided or community MCP/API; resolves POI and first/last-mile routes. Not an official Amap MCP; cannot verify railway trains or hotel prices."
    },
    "weather": {
      "primary": {
        "name": "caiyun-weather",
        "type": "official-hosted",
        "url": "https://mcp-weather.caiyunapp.com/mcp",
        "header": "X-Caiyun-API-Key",
        "requires_key": true
      },
      "fallback": {
        "name": "open-meteo",
        "type": "free-api",
        "requires_key": false
      },
      "check": "scripts/check_weather.py",
      "document": "docs/weather-setup.md"
    },
    "accommodation": {
      "official_api": false,
      "document": "docs/accommodation-tools.md",
      "note": "No public official hotel pricing API/MCP; read sales pages and mark fares as pending confirmation."
    }
  },
  "codearts_compat": {
    "skill_frontmatter_fields": [
      "name",
      "description",
      "language",
      "allowed-tools"
    ],
    "agent_definition_format": "markdown",
    "no_builtin_rag": true
  }
}

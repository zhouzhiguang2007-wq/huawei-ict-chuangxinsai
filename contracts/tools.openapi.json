{
  "openapi": "3.0.3",
  "info": {"title": "Travel shared preference tools", "version": "1.0.0"},
  "servers": [{"url": "http://127.0.0.1:8765", "description": "Local demo; replace with reachable HTTPS backend for cloud use"}],
  "paths": {
    "/v1/tools": {
      "post": {
        "operationId": "travel_shared_tools",
        "summary": "Read or update confirmed preferences, prepare context, or invoke deterministic checks",
        "description": "Authenticated identity is server-owned. Never send user_id. The result data.result retains the native business status; top-level ok is not business approval. See docs/shared-interface.md.",
        "security": [{"bearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolRequest"}}}
        },
        "responses": {
          "200": {"description": "Tool executed; inspect data.result for business outcome", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ToolResponse"}}}},
          "400": {"description": "Invalid request"},
          "401": {"description": "Unauthorized"},
          "403": {"description": "Read-only credential cannot change persistent memory"},
          "503": {"description": "Tool/storage unavailable"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "schemas": {
      "Preferences": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interests": {"type": "array", "items": {"type": "string"}},
          "pace": {"type": "string", "enum": ["relaxed", "balanced", "intensive", "unspecified"]},
          "transport_modes": {"type": "array", "items": {"type": "string", "enum": ["walk", "transit", "drive", "bike", "mixed", "unspecified"]}},
          "walking_tolerance_minutes": {"type": "integer", "minimum": 0},
          "accommodation": {"type": "array", "items": {"type": "string"}},
          "photo_styles": {"type": "array", "items": {"type": "string"}},
          "photo_social_preference": {"type": "string", "enum": ["strangers_ok", "companions_only", "no_interaction", "unspecified"]}
        }
      },
      "Context": {
        "type": "object",
        "required": ["schema_version", "skill", "trip_id"],
        "additionalProperties": false,
        "properties": {
          "schema_version": {"type": "string", "enum": ["1.0"]},
          "skill": {"type": "string", "enum": ["travel-planner-plugin", "travel-requirement-analysis", "multi-platform-travel-planner", "travel-accommodation-advisor", "x-xiake", "travel-plan-review", "travel-handbook-builder", "travel-replanner", "travel-time-pocket"]},
          "trip_id": {"type": "string", "minLength": 1},
          "requirements": {"type": "object", "description": "Native canonical requirements, including preferences and optional confirmed review_requirements", "additionalProperties": true},
          "trip_preferences": {"$ref": "#/components/schemas/Preferences"},
          "explicit_preference_fields": {"type": "array", "items": {"type": "string"}},
          "payload": {"type": "object", "description": "Native target skill input", "additionalProperties": true},
          "preference_snapshot": {"type": "object", "description": "Server-sealed prepare output bound to authenticated user and trip; discard on new user requirements", "additionalProperties": true}
        }
      },
      "ToolRequest": {
        "oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["action"], "properties": {"action": {"type": "string", "enum": ["get", "clear"]}}},
          {"type": "object", "additionalProperties": false, "required": ["action", "preferences", "confirmed", "source"], "properties": {"action": {"type": "string", "enum": ["update"]}, "preferences": {"$ref": "#/components/schemas/Preferences"}, "confirmed": {"type": "boolean", "enum": [true]}, "source": {"type": "string", "minLength": 1}}},
          {"type": "object", "additionalProperties": false, "required": ["action", "fields"], "properties": {"action": {"type": "string", "enum": ["delete"]}, "fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
          {"type": "object", "additionalProperties": false, "required": ["action", "context"], "properties": {"action": {"type": "string", "enum": ["prepare", "invoke"]}, "context": {"$ref": "#/components/schemas/Context"}}}
        ]
      },
      "ToolResponse": {
        "type": "object",
        "required": ["schema_version", "action", "status", "data", "warnings", "errors"],
        "properties": {
          "schema_version": {"type": "string", "enum": ["1.0"]},
          "action": {"type": "string", "nullable": true},
          "status": {"type": "string", "enum": ["ok", "invalid", "unavailable"]},
          "data": {"type": "object", "additionalProperties": true},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "errors": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}

{
  "openapi": "3.0.3",
  "info": {
    "title": "Travel shared preference tools",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765",
      "description": "Local demo; replace with reachable HTTPS backend for cloud use"
    }
  ],
  "paths": {
    "/v1/tools": {
      "post": {
        "operationId": "travel_shared_tools",
        "summary": "Read or update confirmed preferences, prepare context, or invoke deterministic checks",
        "description": "Authenticated identity is server-owned. Never send user_id. The result data.result retains the native business status; top-level ok is not business approval. See docs/shared-interface.md.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToolRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tool executed; inspect data.result for business outcome",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Tool/storage unavailable"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Preferences": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pace": {
            "type": "string",
            "enum": [
              "relaxed",
              "balanced",
              "intensive",
              "unspecified"
            ]
          },
          "transport_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "walk",
                "transit",
                "drive",
                "bike",
                "mixed",
                "unspecified"
              ]
            }
          },
          "walking_tolerance_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "accommodation": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "photo_styles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "photo_social_preference": {
            "type": "string",
            "enum": [
              "strangers_ok",
              "companions_only",
              "no_interaction",
              "unspecified"
            ]
          }
        }
      },
      "Context": {
        "type": "object",
        "required": [
          "schema_version",
          "skill",
          "trip_id"
        ],
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "skill": {
            "type": "string",
            "enum": [
              "travel-planner-plugin",
              "travel-requirement-analysis",
              "multi-platform-travel-planner",
              "travel-accommodation-advisor",
              "x-xiake",
              "travel-plan-review",
              "travel-handbook-builder",
              "travel-replanner",
              "travel-time-pocket"
            ]
          },
          "trip_id": {
            "type": "string",
            "minLength": 1
          },
          "requirements": {
            "type": "object",
            "description": "Native canonical requirements, including preferences and optional confirmed review_requirements",
            "additionalProperties": true
          },
          "trip_preferences": {
            "$ref": "#/components/schemas/Preferences"
          },
          "explicit_preference_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "payload": {
            "type": "object",
            "description": "Native target skill input",
            "additionalProperties": true
          },
          "preference_snapshot": {
            "type": "object",
            "description": "Host-owned prepare output reused within a run; discard on new user requirements",
            "additionalProperties": true
          }
        }
      },
      "ToolRequest": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "get",
                  "clear"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "preferences",
              "confirmed",
              "source"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "update"
                ]
              },
              "preferences": {
                "$ref": "#/components/schemas/Preferences"
              },
              "confirmed": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "fields"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "delete"
                ]
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "context"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "prepare",
                  "invoke"
                ]
              },
              "context": {
                "$ref": "#/components/schemas/Context"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "knowledge_query"
                ]
              },
              "category": {
                "type": "string"
              },
              "key": {
                "type": "string"
              },
              "keyword": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "category",
              "key",
              "value"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "knowledge_upsert"
                ]
              },
              "category": {
                "type": "string"
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "object"
              },
              "source": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "knowledge_categories"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "trip_id",
              "skill",
              "stage",
              "key",
              "value"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "session_put"
                ]
              },
              "trip_id": {
                "type": "string",
                "minLength": 1
              },
              "skill": {
                "type": "string"
              },
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "trip_id"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "session_get"
                ]
              },
              "trip_id": {
                "type": "string",
                "minLength": 1
              },
              "skill": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "trip_id"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "session_get_requirements"
                ]
              },
              "trip_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "session_list_trips"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "trip_id",
              "skill",
              "stage"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "session_clear_stage"
                ]
              },
              "trip_id": {
                "type": "string",
                "minLength": 1
              },
              "skill": {
                "type": "string"
              },
              "stage": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "trip_id"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "session_clear_trip"
                ]
              },
              "trip_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "query"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "registry_query"
                ]
              },
              "query": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "skill_name"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "registry_get"
                ]
              },
              "skill_name": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "registry_list"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "skill_name"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "registry_dependencies"
                ]
              },
              "skill_name": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "step"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "questionnaire_get_step"
                ]
              },
              "step": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "questionnaire_list"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "current_step"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "questionnaire_next"
                ]
              },
              "current_step": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "questionnaire_dimensions"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "seed"
                ]
              }
            }
          }
        ]
      },
      "ToolResponse": {
        "type": "object",
        "required": [
          "schema_version",
          "action",
          "status",
          "data",
          "warnings",
          "errors"
        ],
        "properties": {
          "schema_version": {
            "type": "string",
            "enum": [
              "1.0"
            ]
          },
          "action": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "invalid",
              "unavailable"
            ]
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Travel planner plugin manifest",
  "type": "object",
  "required": [
    "name",
    "version",
    "entry_skill",
    "skills",
    "orchestration",
    "rag",
    "agent",
    "shared_tools"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "install_check": {
      "type": "string",
      "description": "安装版本自检脚本的相对路径"
    },
    "entry_skill": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "orchestration": {
      "type": "object",
      "required": [
        "main_flow",
        "post_delivery"
      ],
      "properties": {
        "main_flow": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "post_delivery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rag": {
      "type": "object",
      "required": [
        "index_dir",
        "build_script",
        "retrieve_script",
        "embedding_model"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "index_dir": {
          "type": "string"
        },
        "build_script": {
          "type": "string"
        },
        "validate_script": {
          "type": "string"
        },
        "retrieve_script": {
          "type": "string"
        },
        "embedding_model": {
          "type": "string"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "shared_tools": {
      "type": "object",
      "required": [
        "module",
        "contract_document",
        "openapi",
        "requirement_agent",
        "auto_registered"
      ],
      "properties": {
        "contract_version": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "contract_document": {
          "type": "string"
        },
        "openapi": {
          "type": "string"
        },
        "storage": {
          "type": "string"
        },
        "database_env": {
          "type": "string"
        },
        "internal_database_env": {
          "type": "string"
        },
        "runtime_root_env": {
          "type": "string"
        },
        "requires_seed": {
          "type": "boolean"
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "questionnaire": {
          "type": "object",
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 1
            },
            "storage": {
              "type": "string"
            },
            "requires_seed": {
              "type": "boolean"
            },
            "gate": {
              "type": "string"
            },
            "action_read": {
              "type": "string"
            }
          }
        },
        "requirement_agent": {
          "type": "string"
        },
        "auto_registered": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "string"
    },
    "mcp_servers": {
      "type": "object"
    },
    "codearts_compat": {
      "type": "object"
    },
    "skill_graph": {
      "type": "object"
    },
    "deployment": {
      "type": "object"
    },
    "acceptance": {
      "type": "object"
    }
  }
}
